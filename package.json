{
  "name": "relatorio-google-ads",
  "version": "2.0.0", 
  "description": "Gerador automático de relatórios Google Ads com monitoramento em tempo real",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "watch": "node app.js --watch", 
    "dev": "node app.js --watch",
    "legacy": "node generator.js",
    "clean": "node clean-and-organize.js",
    "clean:force": "node clean-and-organize.js && npm run clean:cache",
    "clean:cache": "node -e \"const fs=require('fs-extra'); fs.emptyDirSync('./cache'); fs.emptyDirSync('./output'); console.log('Cache limpo!')\"",
    "logs": "node scripts/logs.js", 
    "status": "node app.js --status",
    "setup": "node setup.js"
  },
  "dependencies": {
    "puppeteer": "^21.0.0",
    "chokidar": "^3.5.3", 
    "chalk": "^4.1.2",
    "fs-extra": "^11.2.0",
    "lodash": "^4.17.21"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "relatórios", 
    "pdf", 
    "automação", 
    "marketing", 
    "google-ads", 
    "monitoramento"
  ]
}